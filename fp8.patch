+def _can_dequantize_fp8_block(converter, weight, weight_scale_inv):
+    if not (
+        HAS_TRITON
+        and weight.is_cuda
+        and torch.version.hip is None
+        and weight.device == weight_scale_inv.device
+        and weight.ndim == 2
+        and weight.numel() > 0
+        and weight.is_contiguous()
+        and weight_scale_inv.is_contiguous()
+        and weight.dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
+        and weight_scale_inv.dtype in (torch.bfloat16, torch.float16, torch.float32)
+        and converter.dtype in (torch.bfloat16, torch.float16, torch.float32)
+        and not (
+            torch.is_grad_enabled()
+            and (weight.requires_grad or weight_scale_inv.requires_grad)
+        )
+        and torch.cuda.get_device_capability(weight.device) >= (8, 9)
+    ):
+        return False
+
+    rows, cols = weight.shape
+    h, w = converter.weight_block_size
+    return (
+        h > 0
+        and w > 0
+        and weight_scale_inv.shape == (triton.cdiv(rows, h), triton.cdiv(cols, w))
+    )
+
+
+@triton.jit
+def _dequantize_fp8_block_kernel(
+    weight,
+    scales,
+    out,
+    numel,
+    COLS: tl.constexpr,
+    H: tl.constexpr,
+    W: tl.constexpr,
+    TILE: tl.constexpr,
+):
+    offsets = tl.program_id(0).to(tl.int64) * TILE + tl.arange(0, TILE)
+    rows = offsets // COLS
+    cols = offsets % COLS
+    scale_offsets = (rows // H) * tl.cdiv(COLS, W) + cols // W
+    mask = offsets < numel
+    values = tl.load(weight + offsets, mask, other=0.0).to(tl.float32)
+    scale = tl.load(scales + scale_offsets, mask, other=0).to(tl.float32)
+    tl.store(out + offsets, values * scale, mask)
+
+
+@ImplBackend.register("dequantize_fp8_block", _can_dequantize_fp8_block, 0)
+def _dequantize_fp8_block_triton(converter, weight, weight_scale_inv):
+    out = torch.empty_like(weight, dtype=converter.dtype)
+    h, w = converter.weight_block_size
+    tile = 512
+    with torch.cuda.device(weight.device):
+        _dequantize_fp8_block_kernel[(triton.cdiv(weight.numel(), tile),)](
+            weight, weight_scale_inv, out, weight.numel(), weight.size(1), h, w, tile
+        )
+    return out
