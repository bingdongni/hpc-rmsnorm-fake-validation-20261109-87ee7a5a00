 import pytest
 import torch
 from compressed_tensors.entrypoints.convert import FP8BlockDequantizer
+from compressed_tensors.utils.impl_backend import ImplBackend
+from compressed_tensors.utils.triton import HAS_TRITON
+
+
+@pytest.mark.unit
+@pytest.mark.skipif(
+    not (
+        HAS_TRITON
+        and torch.cuda.is_available()
+        and torch.version.hip is None
+        and torch.cuda.get_device_capability() >= (8, 9)
+    ),
+    reason="requires Triton and CUDA FP8 support",
+)
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float16, torch.float32])
+@pytest.mark.parametrize(
+    "fp8,scale_dtype,shape,block",
+    [
+        (torch.float8_e4m3fn, torch.bfloat16, (256, 384), (128, 128)),
+        (torch.float8_e5m2, torch.float32, (35, 67), (7, 12)),
+        (torch.float8_e4m3fn, torch.float16, (1, 3), (16, 16)),
+    ],
+)
+def test_fp8_block_triton(dtype, fp8, scale_dtype, shape, block):
+    weight = torch.randn(shape, device="cuda").to(fp8)
+    rows, cols = shape
+    h, w = block
+    scales = torch.randn(
+        (rows + h - 1) // h, (cols + w - 1) // w, dtype=scale_dtype, device="cuda"
+    )
+    converter = FP8BlockDequantizer(weight_block_size=block, dtype=dtype)
+    actual = ImplBackend.call("_dequantize_fp8_block_triton", converter, weight, scales)
+    expanded = scales.repeat_interleave(h, 0).repeat_interleave(w, 1)[:rows, :cols]
+    expected = (weight.float() * expanded.float()).to(dtype)
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+
+
+@pytest.mark.unit
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+def test_fp8_block_scale_gradient():
+    weight = torch.arange(32, device="cuda").reshape(4, 8).to(torch.float8_e4m3fn)
+    scales = torch.ones(2, 2, device="cuda", requires_grad=True)
+    converter = FP8BlockDequantizer(weight_block_size=(2, 4), dtype=torch.float32)
+    converted = converter.process(
+        {"proj.weight": weight, "proj.weight_scale_inv": scales}
+    )
+    converted["proj.weight"].sum().backward()
+    expected = weight.float().reshape(2, 2, 2, 4).sum(dim=(1, 3))
+    torch.testing.assert_close(scales.grad, expected, atol=0, rtol=0)
 
 
 @pytest.mark.unit
