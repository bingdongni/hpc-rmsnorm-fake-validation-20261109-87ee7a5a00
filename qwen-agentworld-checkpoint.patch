+"""
+        env = os.environ.copy()
+        eval_dir = str(Path(__file__).resolve().parents[1] / "eval")
+        env["PYTHONPATH"] = os.pathsep.join([eval_dir, env.get("PYTHONPATH", "")])
+        result = subprocess.run([sys.executable, "-c", script, str(self.path), signature, json.dumps(data)],
