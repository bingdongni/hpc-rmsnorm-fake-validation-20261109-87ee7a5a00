+def _wait_for_event(event: torch.Event, device: torch.device) -> None:
+    if device.type == "cuda":
+        torch.cuda.current_stream(device).wait_event(event)
+    elif device.type == "xpu":
+        torch.xpu.current_stream(device).wait_event(event)
+    else:
+        torch.accelerator.current_stream(device).wait_event(event)
+
+
+class _QuantizedWork(Work):
+    """A communication work whose completion includes GPU postprocessing."""
+
+    def __init__(
+        self,
+        work: Work,
+        done: torch.Event,
+        outputs: list[torch.Tensor],
+        buffers: list[torch.Tensor],
+    ):
+        super().__init__()
+        self._work = work
+        self._done = done
+        self._buffers = buffers
+        self._device = outputs[0].device
+        self._result_lock = threading.Lock()
+        self._result_future: Optional[Future[int]] = None
+
+        def finish(fut: Future[list[torch.Tensor]]) -> list[torch.Tensor]:
+            # Keep the communication buffers alive until this callback is queued.
+            _ = buffers
+            fut.wait()
+            _wait_for_event(done, outputs[0].device)
+            return outputs
+
+        self._future = work.get_future().then(finish)
+
+    def wait(self, timeout: Optional[timedelta] = None) -> bool:
+        success = self._work.wait() if timeout is None else self._work.wait(timeout)
+        if success:
+            _wait_for_event(self._done, self._device)
+        return success
+
+    def block_current_stream(self) -> None:
+        _wait_for_event(self._done, self._device)
+
+    def synchronize(self) -> None:
+        self.wait()
+
+    def get_future(self) -> Future[list[torch.Tensor]]:
+        return self._future
+
+    def is_completed(self) -> bool:
+        if not self._work.is_completed():
+            return False
+        # pyrefly: ignore [missing-attribute]
+        status = self._work.get_future_result()
+        if not status.done():
+            return False
+        try:
+            if int(status.value()) != 0:
+                return True
+        except Exception:
+            return True
+        return self._done.query()
+
+    def is_success(self) -> bool:
+        return self._work.is_success()
+
+    def result(self) -> list[torch.Tensor]:
+        return self._future.wait()
+
+    def get_future_result(self) -> Future[int]:
+        with self._result_lock:
+            if self._result_future is None:
+                # pyrefly: ignore [missing-attribute]
+                backend_result = self._work.get_future_result()
+                result: Future[int] = Future()
+
+                def complete() -> None:
+                    try:
+                        value = backend_result.wait()
+                        # WorkResult.SUCCESS is 0. On failure, the GPU event may
+                        # never complete, so return the status without waiting.
+                        if int(value) == 0:
+                            self._done.synchronize()
+                        result.set_result(value)
+                    except Exception as exc:
+                        # pyrefly: ignore [bad-argument-type]
+                        result.set_exception(exc)
+
+                # The backend status Future does not track CUDA streams. Avoid
+                # synchronizing an event on the NCCL watchdog thread.
+                threading.Thread(target=complete, daemon=True).start()
+                self._result_future = result
+            return self._result_future
+
+
