index 0000000..19318b0
--- /dev/null
+++ b/torchft/collectives_work_test.py
@@ -0,0 +1,227 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+# All rights reserved.
+#
+# This source code is licensed under the BSD-style license found in the
+# LICENSE file in the root directory of this source tree.
+
+import gc
+from datetime import timedelta
+from typing import cast
+from unittest import skipUnless, TestCase
+
+import torch
+from torch.distributed import ProcessGroup, ReduceOp
+from torchft.collectives import allreduce_quantized, reduce_scatter_quantized
+
+
+class _FakeWork:
+    def __init__(self, future, event):
+        self.future = future
+        self.event = event
+        self.last_timeout = None
+        self.status = torch.futures.Future()
+
+    def wait(self, timeout=None):
+        self.last_timeout = timeout
+        torch.cuda.current_stream().wait_event(self.event)
+        return True
+
+    def block_current_stream(self):
+        torch.cuda.current_stream().wait_event(self.event)
+
+    def get_future(self):
+        return self.future
+
+    def get_future_result(self):
+        return self.status
+
+    def is_completed(self):
+        return self.future.done()
+
+    def is_success(self):
+        return True
+
+
+class _FakeGroup:
+    """A one-rank group whose communication Future is explicitly completed."""
+
+    def __init__(self, scatter):
+        self.scatter = scatter
+        self.pending = None
+
+    def rank(self):
+        return 0
+
+    def size(self):
+        return 1
+
+    def alltoall_base(self, output, inputs, *args):
+        output.copy_(inputs)
+        self.transport = output
+        if self.scatter:
+            # Two one-element rows: each scale occupies every other float.
+            output.view(torch.float32).reshape(-1)[::2].mul_(0.5)
+            self.pending = torch.futures.Future(devices=[output.device])
+            future = self.pending
+        else:
+            future = torch.futures.Future(devices=[output.device])
+            future.set_result([output])
+        self.last_work = _FakeWork(future, torch.cuda.current_stream().record_event())
+        return self.last_work
+
+    def allgather_into_tensor_coalesced(self, outputs, inputs, options):
+        outputs[0].copy_(inputs[0])
+        self.transport = outputs[0]
+        outputs[0].view(torch.float32).reshape(-1)[::2].mul_(0.5)
+        self.pending = torch.futures.Future(devices=[outputs[0].device])
+        self.last_work = _FakeWork(
+            self.pending, torch.cuda.current_stream().record_event()
+        )
+        return self.last_work
+
+
+@skipUnless(torch.cuda.is_available(), "CUDA is required")
+class QuantizedWorkTest(TestCase):
+    def _start(self, scatter, delay=False, generic_stream=False):
+        values = torch.tensor([1.0, 2.0], device="cuda")
+        output = torch.full_like(values, -1.0) if scatter else values
+        group = _FakeGroup(scatter)
+        stream = torch.Stream(device="cuda") if generic_stream else torch.cuda.Stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(cast(torch.cuda.Stream, stream)):
+            if delay:
+                torch.cuda._sleep(50_000_000)
+            if scatter:
+                work = reduce_scatter_quantized(
+                    output, [values], ReduceOp.SUM, cast(ProcessGroup, group), stream
+                )
+            else:
+                work = allreduce_quantized(
+                    [values], ReduceOp.SUM, cast(ProcessGroup, group), stream
+                )
+        return work, output, group
+
+    def test_wait_and_block_current_stream_include_postprocessing(self):
+        for scatter in (False, True):
+            for method in ("wait", "block_current_stream"):
+                with self.subTest(scatter=scatter, method=method):
+                    work, output, group = self._start(scatter)
+                    consumer = torch.cuda.Stream()
+                    with torch.cuda.stream(consumer):
+                        getattr(work, method)()
+                        actual = output.clone()
+                    consumer.synchronize()
+                    torch.testing.assert_close(
+                        actual.cpu(), torch.tensor([2.0, 4.0]), rtol=0.02, atol=0.05
+                    )
+                    group.pending.set_result([group.transport])
+
+    def test_future_composes_postprocessing_on_consumer_stream(self):
+        for scatter in (False, True):
+            for generic_stream in (False, True):
+                with self.subTest(scatter=scatter, generic_stream=generic_stream):
+                    work, output, group = self._start(
+                        scatter, delay=True, generic_stream=generic_stream
+                    )
+                    future = work.get_future()
+                    self.assertFalse(future.done())
+                    group.pending.set_result([group.transport])
+                    consumer = torch.cuda.Stream()
+                    with torch.cuda.stream(consumer):
+                        result = future.wait()
+                        actual = output.clone()
+                    consumer.synchronize()
+                    self.assertIs(result[0], output)
+                    torch.testing.assert_close(
+                        actual.cpu(), torch.tensor([2.0, 4.0]), rtol=0.02, atol=0.05
+                    )
+
+    def test_future_propagates_communication_errors(self):
+        for scatter in (False, True):
+            with self.subTest(scatter=scatter):
+                work, output, group = self._start(scatter)
+                future = work.get_future()
+                group.pending.set_exception(RuntimeError("communication failed"))
+                with self.assertRaisesRegex(RuntimeError, "communication failed"):
+                    future.wait()
+
+    def test_wait_forwards_timeout(self):
+        work, output, group = self._start(False)
+        timeout = timedelta(seconds=2)
+        self.assertTrue(work.wait(timeout))
+        self.assertEqual(group.last_work.last_timeout, timeout)
+        group.pending.set_result([group.transport])
+
+    def test_work_result_future_waits_for_postprocessing(self):
+        for scatter in (False, True):
+            with self.subTest(scatter=scatter):
+                work, output, group = self._start(scatter)
+                self.assertIs(work.get_future_result(), work.get_future_result())
+                group.last_work.status.set_result(0)
+                self.assertEqual(work.get_future_result().wait(), 0)
+                torch.testing.assert_close(
+                    output.cpu(), torch.tensor([2.0, 4.0]), rtol=0.02, atol=0.05
+                )
+                group.pending.set_result([group.transport])
+
+    def test_work_result_future_propagates_failure(self):
+        work, output, group = self._start(False)
+        group.last_work.status.set_exception(RuntimeError("status failure"))
+        with self.assertRaisesRegex(RuntimeError, "status failure"):
+            work.get_future_result().wait()
+        group.pending.set_result([group.transport])
+
+    def test_failed_backend_status_does_not_wait_for_postprocessing(self):
+        work, output, group = self._start(False)
+
+        class NeverCompletes:
+            def synchronize(self):
+                raise AssertionError("must not wait on a failed backend status")
+
+        setattr(work, "_done", NeverCompletes())
+        group.last_work.status.set_result(2)
+        self.assertEqual(work.get_future_result().wait(), 2)
+        group.pending.set_result([group.transport])
+
+    def test_is_completed_reports_backend_failure_without_querying_event(self):
+        work, output, group = self._start(False)
+        group.pending.set_result([group.transport])
+        self.assertFalse(work.is_completed())
+
+        class FailedDeviceEvent:
+            def query(self):
+                raise AssertionError("must not query an event after backend failure")
+
+        setattr(work, "_done", FailedDeviceEvent())
+        group.last_work.status.set_result(2)
+        self.assertTrue(work.is_completed())
+
+    def test_reduce_scatter_keeps_input_storage_alive_on_other_stream(self):
+        pending_checks = 0
+        for _ in range(5):
+            values = torch.tensor([1.0, 2.0], device="cuda")
+            address = values.data_ptr()
+            output = torch.full_like(values, -1.0)
+            stream = torch.cuda.Stream()
+            stream.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(stream):
+                torch.cuda._sleep(300_000_000)
+            group = _FakeGroup(True)
+            work = reduce_scatter_quantized(
+                output, [values], ReduceOp.SUM, cast(ProcessGroup, group), stream
+            )
+            del values
+            gc.collect()
+            allocations = [
+                torch.empty(2, device="cuda").fill_(-123.0) for _ in range(64)
+            ]
+            if not stream.query():
+                pending_checks += 1
+                self.assertTrue(all(item.data_ptr() != address for item in allocations))
+            work.wait()
+            torch.testing.assert_close(
+                output.cpu(), torch.tensor([2.0, 4.0]), rtol=0.02, atol=0.05
+            )
+            assert group.pending is not None
+            group.pending.set_result([group.transport])
+        self.assertGreater(pending_checks, 0)
